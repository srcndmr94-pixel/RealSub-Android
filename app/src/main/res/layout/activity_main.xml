<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="RealSub"
            android:textColor="@color/txt"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Ekrandaki İngilizce altyazıyı okur, sokak ağzına sadık Türkçesini ekranın üstünde gösterir."
            android:textColor="@color/muted"
            android:textSize="14sp" />

        <!-- 1. izinler -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/panel"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1. İzinler"
                android:textColor="@color/txt"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvPerm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="—"
                android:textColor="@color/muted"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnOverlayPerm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/btn_grey"
                android:text="Ekranın üstüne çizme iznini ver"
                android:textAllCaps="false"
                android:textColor="@color/txt" />
        </LinearLayout>

        <!-- 2. anahtar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/panel"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2. Çeviri anahtarı"
                android:textColor="@color/txt"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Google AI Studio'dan aldığın anahtarı yapıştır. Boş bırakırsan ücretsiz motor kullanılır (daha yüzeysel çevirir)."
                android:textColor="@color/muted"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/etKey"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/field"
                android:hint="API anahtarı"
                android:inputType="textPassword"
                android:padding="14dp"
                android:textColor="@color/txt"
                android:textColorHint="@color/muted"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/etModel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/field"
                android:hint="model (örn. gemini-3.8-flash)"
                android:inputType="text"
                android:padding="14dp"
                android:textColor="@color/txt"
                android:textColorHint="@color/muted"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- 3. alan -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/panel"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3. Altyazı yakalama"
                android:textColor="@color/txt"
                android:textSize="16sp"
                android:textStyle="bold" />

            <CheckBox
                android:id="@+id/cbAuto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Altyazıyı kendisi bulsun (önerilen)"
                android:textColor="@color/txt" />

            <TextView
                android:id="@+id/tvRegion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="—"
                android:textColor="@color/muted"
                android:textSize="13sp" />

            <CheckBox
                android:id="@+id/cbAlign"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Çeviriyi altyazının üstüne yerleştir"
                android:textColor="@color/txt" />

            <TextView
                android:id="@+id/tvScan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Taramanın başladığı yükseklik"
                android:textColor="@color/muted"
                android:textSize="13sp" />

            <SeekBar
                android:id="@+id/sbScan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="65"
                android:progress="42" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Altyazı daha yukarıda çıkıyorsa bu değeri küçült. Büyütmek, oynatıcı arayüzünün okunmasını engeller."
                android:textColor="@color/muted"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnRegion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/btn_grey"
                android:text="Alanı elle seç"
                android:textAllCaps="false"
                android:textColor="@color/txt" />
        </LinearLayout>

        <!-- 4. ayarlar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/panel"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="4. Ayarlar"
                android:textColor="@color/txt"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Sertlik seviyesi"
                android:textColor="@color/muted"
                android:textSize="13sp" />

            <RadioGroup
                android:id="@+id/rgHard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/rb0"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Yumuşak"
                    android:textColor="@color/txt" />

                <RadioButton
                    android:id="@+id/rb1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Doğal"
                    android:textColor="@color/txt" />

                <RadioButton
                    android:id="@+id/rb2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Sokak ağzı"
                    android:textColor="@color/txt" />

                <RadioButton
                    android:id="@+id/rb3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Tam sansürsüz"
                    android:textColor="@color/txt" />
            </RadioGroup>

            <TextView
                android:id="@+id/tvSize"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Yazı boyutu"
                android:textColor="@color/muted"
                android:textSize="13sp" />

            <SeekBar
                android:id="@+id/sbSize"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="42"
                android:progress="12" />

            <TextView
                android:id="@+id/tvBottom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Alttan uzaklık"
                android:textColor="@color/muted"
                android:textSize="13sp" />

            <SeekBar
                android:id="@+id/sbBottom"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="60"
                android:progress="10" />

            <CheckBox
                android:id="@+id/cbEn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="İngilizceyi de göster"
                android:textColor="@color/txt" />
        </LinearLayout>

        <Button
            android:id="@+id/btnStart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/btn"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:text="Başlat"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnStop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/btn_grey"
            android:text="Durdur"
            android:textAllCaps="false"
            android:textColor="@color/txt" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/panel"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="5. Durum"
                android:textColor="@color/txt"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Bir şey görünmüyorsa: çalışırken buraya dön, önce Tek kare oku, sonra Durumu yenile."
                android:textColor="@color/muted"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnTest"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/btn_grey"
                android:text="Tek kare oku"
                android:textAllCaps="false"
                android:textColor="@color/txt" />

            <Button
                android:id="@+id/btnStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/btn_grey"
                android:text="Durumu yenile"
                android:textAllCaps="false"
                android:textColor="@color/txt" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/field"
                android:padding="12dp"
                android:text="—"
                android:textColor="@color/txt"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="24dp"
            android:text="Başlat'a bastıktan sonra uygulamadan çık, izlemeye başla. Altyazı ekranın üstünde görünür. Durdurmak için bildirime dokun."
            android:textColor="@color/muted"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
